# Vorlage für eigene Einstellungen. Nach .env kopieren und anpassen:
#   cp .env.example .env
# Danach übernehmen mit:  docker compose up -d
# Leere oder fehlende Werte = Funktion aus bzw. Einstellung im Webinterface.
#
# TELERIX_EXTERNAL_ADDRESS, TELERIX_TESTPHONE_PASSWORD und die Tonwerte
# (TELERIX_AUDIO_...) lassen sich auch im Webinterface einstellen
# (Konfiguration). Ist einer davon hier gesetzt, hat er Vorrang und das Feld
# im Webinterface ist gesperrt.

# GitHub-Repository für die Update-Prüfung (setzt install.sh automatisch)
TELERIX_UPDATE_REPO=rcdr11/Telerix

# Server hinter NAT: öffentliche IPv4-Adresse oder Hostname für SIP/RTP.
# Nötig, wenn beim Anrufer kein Ton ankommt (dazu Ports freigeben, siehe
# docs/konfiguration.md).
#TELERIX_EXTERNAL_ADDRESS=203.0.113.10

# SIP nur von den Netzen des SIP-Anbieters annehmen (IPv4/IPv6/CIDR, durch
# Komma getrennt; Standard leer = von überall). localhost und private Netze
# bleiben immer erlaubt. Netze bitte beim Anbieter nachsehen, siehe
# docs/konfiguration.md. Ein ungültiger Eintrag verhindert den Start.
#TELERIX_SIP_ALLOW=217.10.64.0/20,217.116.112.0/20,212.9.32.0/19

# Hinter einem Reverse-Proxy: dessen Adresse oder Netz (IPv4/IPv6/CIDR,
# durch Komma getrennt). Nur Proxy-Adressen, keine Client-Netze!
#TELERIX_TRUSTED_PROXIES=172.30.0.10

# Hinter einem HTTPS-Proxy auf 1 setzen (Session-Cookie nur über HTTPS)
#TELERIX_COOKIE_SECURE=1

# Optionales Testtelefon "testphone" (mind. 12 Zeichen aus A-Z a-z 0-9 . _ + -)
#TELERIX_TESTPHONE_PASSWORD=

# Tonaufbereitung (siehe docs/tonqualitaet.md)
# Lautstärke am Telefon in dB (Standard 0 = unverändert; erlaubt -24 bis 24)
#TELERIX_AUDIO_ANHEBUNG_DB=0
# Vorlauf gegen Stockungen des Streams in Sekunden (Standard 4; 0 bis 10).
# Um diese Zeit kommt der Ton verzögert beim Anrufer an.
#TELERIX_AUDIO_PUFFER_SEKUNDEN=4
